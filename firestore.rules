rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Perfiles de usuario (cada usuario solo lee y edita su propio documento)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Grupos de trabajo / finanzas
    match /groups/{groupId} {
      // Crear grupo si el usuario autenticado se incluye en members
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      
      // Leer documento o listar grupos donde el usuario es miembro
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      
      // Actualizar (ej. unirse a un grupo)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members || 
        request.auth.uid in request.resource.data.members
      );
      
      // Eliminar solo el creador
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Subcolecciones (transacciones, deudas, abonos, gastos fijos)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
